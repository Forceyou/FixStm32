	(text "ONBOARD IMU: U4 MPU9250 (QFN-24, SPI mode)\nSCLK=PA5 SDI=PA7 SDO=PA6 nCS=PE4 INT=open(polling)\nC10 REGOUT=100nF, C11 VDD bypass=100nF, FSYNC->GND, AUX_CL/AUX_DA open\nVerify pin numbers vs PS-MPU-9250A-01 before layout!"
		(at 45 232 0) (effects (font (size 2 2)) (justify left bottom))
		(uuid "e3000001-0000-4000-8000-000000000001"))

	(text "SBUS INVERTER: J6 receiver signal (inverted UART 100k 8E2)\nQ1 BC847 + R8 base 10k + R9 pullup 10k -> PA10\nSTM32F4 USART has no hardware inversion"
		(at 45 180 0) (effects (font (size 2 2)) (justify left bottom))
		(uuid "e3000002-0000-4000-8000-000000000002"))

	(text "POWER: J1 (VBAT/5V/GND from BEC) -> U2 AMS1117-3.3 -> +3V3 rail\nC1=10uF C2=22uF"
		(at 37 30 0) (effects (font (size 2 2)) (justify left bottom))
		(uuid "e3000003-0000-4000-8000-000000000003"))

	(text "RESET: R3 10k pullup + C7 100nF + SW1 to GND"
		(at 110 62 0) (effects (font (size 2 2)) (justify left bottom))
		(uuid "e3000004-0000-4000-8000-000000000004"))

	(text "HSE: X1 8MHz + C8/C9 20pF (PLL -> 168MHz SYSCLK)"
		(at 245 78 0) (effects (font (size 2 2)) (justify left bottom))
		(uuid "e3000005-0000-4000-8000-000000000005"))

	(text "USB FS: PA11/PA12 via 22R series (R5/R6)"
		(at 100 132 0) (effects (font (size 2 2)) (justify left bottom))
		(uuid "e3000006-0000-4000-8000-000000000006"))

	(text "Voltage divider: VBAT --R1 10k--+-- R2 3.3k-- GND\nmidpoint -> PA0 (max 12.6V/4.03 = 3.12V OK)\nSet VOLTAGE_SCALE 4.03f in config.h"
		(at 175 192 0) (effects (font (size 2 2)) (justify left bottom))
		(uuid "e3000007-0000-4000-8000-000000000007"))

